@article{Barnes2018-ff,
  title = {A Hundred-Year Classic: {{Peter}} Haggett's Locational Analysis in Human Geography (1965)},
  author = {Barnes, Trevor J},
  year = 2018,
  month = jul,
  volume = {100},
  number = {3},
  pages = {294--299},
  publisher = {Routledge},
  doi = {10.1080/04353684.2018.1471728},
  abstract = {This paper celebrates one of the classic volumes written in Anglophone human geography over the last one hundred years since Geografiska Annaler first appeared, Peter Haggett?s (1965) Locational Analysis in Human Geography. It is a classic because it fulfils Italo Calvino?s definition of ?a book that has never finished saying what it has to say?. By examining the details of how the book was written and delineating its intellectual contribution to human geography, the paper argues that Locational Analysis meets Calvino?s designation.},
  keywords = {SpatialEquity}
}

